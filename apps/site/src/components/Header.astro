---
import { ctaPrincipal, nav, site } from "../data/site";

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-borda bg-superficie/95 text-texto backdrop-blur">
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="shrink-0 rounded-md" aria-label={`${site.name}, página inicial`}>
      <img src="/marca/logo-cabecalho-claro.svg" alt="" width="200" height="50" class="h-[50px] w-[200px] dark:hidden" />
      <img src="/marca/logo-cabecalho-escuro.svg" alt="" width="200" height="50" class="hidden h-[50px] w-[200px] dark:block" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[15px] font-semibold">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="relative py-2 text-suave transition-colors hover:text-texto aria-[current=page]:text-texto aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-marca"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="tema-toggle"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-borda text-texto transition-colors hover:border-marca"
        aria-label="Ativar tema escuro"
        aria-pressed="false"
      >
        <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>

      <a
        href={ctaPrincipal.href}
        class="hidden rounded-full bg-marca px-5 py-2.5 text-[15px] font-bold text-grafite transition-colors hover:bg-chama lg:inline-block"
      >
        {ctaPrincipal.label}
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="rounded-lg p-2 text-texto lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-aberto" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-fechado hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Principal (celular)" class="hidden border-t border-borda lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-4 text-lg font-semibold sm:px-6">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="block py-3 text-suave aria-[current=page]:text-marca-texto"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3">
        <a href={ctaPrincipal.href} class="block rounded-full bg-marca px-5 py-3 text-center font-bold text-grafite">
          {ctaPrincipal.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const tema = document.getElementById("tema-toggle") as HTMLButtonElement;
  const aplicarTema = (escuro: boolean) => {
    document.documentElement.dataset.theme = escuro ? "dark" : "light";
    tema.setAttribute("aria-pressed", String(escuro));
    tema.setAttribute("aria-label", escuro ? "Ativar tema claro" : "Ativar tema escuro");
  };
  aplicarTema(document.documentElement.dataset.theme === "dark");
  tema.addEventListener("click", () => {
    const escuro = document.documentElement.dataset.theme !== "dark";
    try {
      localStorage.setItem("cdrp-tema", escuro ? "dark" : "light");
    } catch {
      /* Sem armazenamento: o tema vale só nesta página. */
    }
    aplicarTema(escuro);
  });
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu-mobile");
  const setOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    toggle?.querySelector(".menu-aberto")?.classList.toggle("hidden", open);
    toggle?.querySelector(".menu-fechado")?.classList.toggle("hidden", !open);
    menu?.classList.toggle("hidden", !open);
  };
  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
