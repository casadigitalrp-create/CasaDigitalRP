---
import { Picture } from "astro:assets";
import fundo from "../assets/fundo-institucional.png";
import { ctaPrincipal, site, whatsappUrl } from "../data/site";

const garantias = [
  "Funciona bem no celular",
  "Contato direto pelo WhatsApp",
  "Você aprova cada etapa",
];
---

<section class="relative isolate overflow-hidden bg-marinho text-white">
  <Picture
    src={fundo}
    alt=""
    formats={["avif", "webp"]}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-right-bottom"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-marinho via-marinho/80 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.15fr_1fr] lg:py-32">
    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-azul uppercase">
        Criação de sites<span class="hidden sm:inline"> · {site.city}</span>
      </p>
      <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-6xl">
        Seu negócio merece um <span class="text-azul">site profissional</span>.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl">
        Sites modernos, responsivos e com contato pelo WhatsApp.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href={ctaPrincipal.href}
          class="rounded-full bg-azul px-7 py-3.5 text-center text-lg font-bold text-marinho shadow-[0_0_32px_-6px] shadow-azul/60 transition-colors hover:bg-white"
        >
          {ctaPrincipal.label}
        </a>
        {
          whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-white/25 px-7 py-3.5 text-center text-lg font-bold text-white transition-colors hover:border-azul hover:text-azul"
            >
              Falar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
            </a>
          )
        }
      </div>

      <ul class="mt-10 flex flex-col gap-3 text-[15px] text-white/80 sm:flex-row sm:flex-wrap sm:gap-x-7">
        {
          garantias.map((g) => (
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-dourado" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
              {g}
            </li>
          ))
        }
      </ul>
      <a href="#modelos" class="mt-7 inline-flex min-h-11 items-center gap-2 font-bold text-azul underline decoration-azul/40 underline-offset-4 hover:text-white">Ver modelos de sites <span aria-hidden="true">↓</span></a>
    </div>

    <!-- Ilustração provisória: painel translúcido com um site em blocos. Será trocada pela imagem P01. -->
    <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-hidden="true">
      <div class="absolute -inset-10 rounded-full bg-azul-medio/25 blur-3xl"></div>
      <div class="relative rounded-2xl border border-azul/30 bg-white/[0.06] p-4 shadow-2xl shadow-black/40 backdrop-blur-md">
        <div class="flex items-center gap-1.5 border-b border-white/10 pb-3">
          <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-dourado/80"></span>
          <span class="ml-3 h-2.5 flex-1 rounded-full bg-white/10"></span>
        </div>
        <div class="mt-4 flex items-center justify-between">
          <span class="h-3 w-20 rounded-full bg-azul/70"></span>
          <span class="flex gap-2">
            <span class="h-2 w-8 rounded-full bg-white/20"></span>
            <span class="h-2 w-8 rounded-full bg-white/20"></span>
            <span class="h-2 w-8 rounded-full bg-white/20"></span>
          </span>
        </div>
        <div class="mt-5 rounded-xl bg-gradient-to-br from-azul-medio/50 to-azul/10 p-5">
          <span class="block h-3.5 w-3/4 rounded-full bg-white/70"></span>
          <span class="mt-2.5 block h-2.5 w-1/2 rounded-full bg-white/35"></span>
          <span class="mt-5 block h-7 w-28 rounded-full bg-azul"></span>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-3">
          <span class="h-16 rounded-lg bg-white/10"></span>
          <span class="h-16 rounded-lg bg-white/10"></span>
          <span class="h-16 rounded-lg bg-white/10"></span>
        </div>
      </div>

      <div class="absolute -right-2 -bottom-8 w-28 rounded-[1.4rem] border border-azul/40 bg-marinho-claro/90 p-2 shadow-xl shadow-black/50 backdrop-blur sm:-right-6">
        <div class="rounded-2xl bg-white/[0.06] p-2.5">
          <span class="block h-2 w-10 rounded-full bg-azul/70"></span>
          <span class="mt-3 block h-12 rounded-lg bg-gradient-to-br from-azul-medio/50 to-azul/10"></span>
          <span class="mt-2 block h-1.5 w-full rounded-full bg-white/20"></span>
          <span class="mt-1.5 block h-1.5 w-2/3 rounded-full bg-white/20"></span>
          <span class="mt-3 block h-5 rounded-full bg-[#25D366]/80"></span>
        </div>
      </div>
    </div>
  </div>
</section>
