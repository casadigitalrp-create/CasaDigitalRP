---
import { ctaPrincipal, site, whatsappUrl } from "../data/site";
import RedeNos from "./RedeNos.astro";

const garantias = [
  "Sem precisar entender de tecnologia",
  "Com o WhatsApp e as planilhas que você já usa",
  "A gente acompanha depois de pronto",
];

// Fluxo ilustrativo: um pedido que chega e segue sozinho até a resposta.
const etapas = [
  { titulo: "Cliente chama no WhatsApp", detalhe: "16:02" },
  { titulo: "n8n registra na planilha", detalhe: "automático" },
  { titulo: "Você recebe o resumo por e-mail", detalhe: "automático" },
  { titulo: "Lembrete enviado ao cliente", detalhe: "1 dia antes" },
];
---

<section class="relative isolate overflow-hidden bg-fundo">
  <RedeNos class="absolute inset-0 -z-10 h-full w-full" />
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.1fr_1fr] lg:py-28">
    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-marca-texto uppercase">
        Automações com n8n<span class="hidden sm:inline"> · Ribeirão Preto e todo o Brasil</span>
      </p>
      <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-6xl">
        {site.name}, <span class="text-marca-texto">{site.slogan}</span>.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-suave sm:text-xl">
        Enquanto você atende, o seu negócio trabalha sozinho: confirma consultas, responde no WhatsApp e organiza cada pedido na planilha. Sem copiar, sem colar, sem esquecer.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a
          href={ctaPrincipal.href}
          class="rounded-full bg-marca px-7 py-3.5 whitespace-nowrap text-center text-lg font-bold text-grafite transition-colors hover:bg-chama"
        >
          Quero meu negócio no automático
        </a>
        {
          whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-texto/25 bg-superficie/70 px-7 py-3.5 whitespace-nowrap text-center text-lg font-bold transition-colors hover:border-marca"
            >
              Conversar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
            </a>
          )
        }
      </div>

      <ul class="mt-10 flex flex-col gap-3 text-[15px] text-suave sm:flex-row sm:flex-wrap sm:gap-x-7">
        {
          garantias.map((g) => (
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-marca" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
              {g}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Ilustração: um fluxo de automação acontecendo, com os nós da marca. -->
    <figure class="relative mx-auto w-full max-w-md rounded-3xl border border-borda bg-superficie p-6 shadow-xl shadow-black/5 lg:max-w-none" aria-label="Exemplo de automação: do WhatsApp à planilha, ao e-mail e ao lembrete">
      <figcaption class="flex items-center justify-between text-sm font-bold">
        <span>Fluxo: novo agendamento</span>
        <span class="rounded-full bg-destaque px-3 py-1 text-xs text-marca-texto">ativo</span>
      </figcaption>
      <ol class="relative mt-6 space-y-5">
        <span class="absolute top-3 bottom-3 left-[11px] w-0.5 bg-marca/40" aria-hidden="true"></span>
        {
          etapas.map((e, i) => (
            <li class="relative flex items-center gap-4">
              <span class={`relative grid h-6 w-6 shrink-0 place-items-center rounded-full ${i === 0 || i === etapas.length - 1 ? "border-[3px] border-marca bg-superficie" : "bg-marca"}`} aria-hidden="true" />
              <span class="flex-1 rounded-xl border border-borda bg-fundo px-4 py-3 text-[15px] font-semibold">{e.titulo}</span>
              <span class="hidden text-xs text-suave sm:inline">{e.detalhe}</span>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>
