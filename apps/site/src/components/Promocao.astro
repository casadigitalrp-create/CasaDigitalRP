---
// Promoção de entrada: site completo com uma automação de e-mail (aprovada em 25/10/2026).
import { promocao } from "../data/site";

interface Props {
  /** Na Vitrine o bloco abre a página; na home, só leva até ela. */
  destaque?: boolean;
}

const { destaque = false } = Astro.props;
---

<section aria-labelledby="promocao-titulo" class={destaque ? "bg-fundo pt-12" : "bg-superficie"}>
  <div class={`mx-auto max-w-6xl px-4 sm:px-6 ${destaque ? "" : "py-20 sm:py-24"}`}>
    <div class="grid items-center gap-10 rounded-3xl border-2 border-marca bg-superficie p-7 sm:p-10 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-marca-texto uppercase">{destaque ? "Promoção" : "Também fazemos sites"}</p>
        <h2 id="promocao-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
          {destaque ? promocao.titulo : "Seu site pronto e já trabalhando sozinho"}
        </h2>
        {!destaque && <p class="mt-2 text-lg font-bold text-marca-texto">{promocao.titulo} · {promocao.preco}</p>}
        <ul class="mt-6 space-y-3">
          {
            promocao.itens.map((item) => (
              <li class="flex gap-3 leading-relaxed">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-marca" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-suave">{promocao.observacao}</p>
      </div>
      <div class="rounded-2xl bg-grafite p-8 text-center text-nevoa">
        <p class="text-areia">Tudo isso por</p>
        <p class="mt-1 text-5xl font-extrabold text-brasa">{promocao.preco}</p>
        <a
          href={destaque ? "/contato/#form-titulo" : "/vitrine/"}
          data-promocao
          class="mt-6 inline-block rounded-full bg-chama px-7 py-3.5 font-bold text-grafite transition-colors hover:bg-faisca"
        >
          {destaque ? "Quero esta promoção" : "Ver modelos e a promoção"}
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ solucao: promocao.solucao }}>
  // Ao pedir a promoção, o Contato já abre com ela escolhida (mesma chave usada pelo Catálogo).
  for (const link of document.querySelectorAll("[data-promocao][href^='/contato/']")) {
    link.addEventListener("click", () => {
      try {
        sessionStorage.setItem("cdrp-catalogo-selecao-v1", JSON.stringify({ solucao, componentes: [], recursos: [], integracoes: [] }));
      } catch {
        /* Sem armazenamento: o visitante escolhe a solução no formulário. */
      }
    });
  }
</script>
