---

// Respostas sem preços ou prazos fixos, alinhadas ao fluxo de proposta e créditos.
const perguntas = [
  {
    pergunta: "Quanto tempo leva para o meu site ficar pronto?",
    resposta:
      "Depende do modelo escolhido e da quantidade de páginas. O prazo é informado na proposta, antes de qualquer compromisso.",
    provisorio: true,
  },
  {
    pergunta: "Por que os preços não aparecem no site?",
    resposta:
      "Cada negócio precisa de uma combinação diferente de páginas e recursos. Por isso o valor é calculado a partir do que você escolher e enviado na proposta.",
    provisorio: true,
  },
  {
    pergunta: "Como recebo a proposta?",
    resposta:
      "Na vitrine você escolhe o modelo e os componentes e envia o pedido pelo WhatsApp ou por e-mail. A partir dele preparamos a sua proposta.",
    provisorio: true,
  },
  {
    pergunta: "Preciso ter domínio e hospedagem?",
    resposta:
      "Se você já tem um domínio, usamos o seu. Se ainda não tem, orientamos o registro em seu nome, para que ele seja sempre seu.",
    provisorio: true,
  },
  {
    pergunta: "O site funciona no celular?",
    resposta:
      "Sim. Os sites são pensados primeiro para o celular e testados também em tablets e computadores.",
    provisorio: true,
  },
  {
    pergunta: "Consigo atualizar o site depois que ele estiver no ar?",
    resposta:
      "Sim. As atualizações são feitas com créditos de atualização, que não expiram e podem ser complementados quando você precisar.",
    provisorio: true,
  },
];
---

<section aria-labelledby="faq-titulo" class="bg-white text-marinho">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-azul-texto uppercase">Dúvidas</p>
      <h2 id="faq-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
        Perguntas frequentes
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-marinho/75">
        Não encontrou o que procurava?{" "}
        <a href="/contato/" class="font-bold text-azul-texto underline decoration-azul-texto/40 underline-offset-4 hover:text-marinho">
          Fale com a gente</a
        >.
      </p>
    </div>

    <div class="divide-y divide-marinho/10 border-y border-marinho/10">
      {
        perguntas.map((p) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg py-5 text-left text-lg font-bold [&::-webkit-details-marker]:hidden">
              {p.pergunta}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-marinho/5 text-azul-texto transition-transform group-open:rotate-45" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pr-12 pb-6 leading-relaxed text-marinho/75">
              {p.resposta}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
