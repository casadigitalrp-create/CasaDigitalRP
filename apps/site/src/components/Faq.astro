---
// Respostas sem prometer prazos ou preços além da promoção aprovada.
import { promocao } from "../data/site";

const perguntas = [
  {
    pergunta: "Preciso entender de tecnologia?",
    resposta:
      "Não. Você conta como é a sua rotina; nós desenhamos o fluxo, explicamos em linguagem simples e cuidamos da parte técnica.",
  },
  {
    pergunta: "Funciona com o que eu já uso?",
    resposta:
      "Na maioria dos casos, sim. O n8n conversa com WhatsApp, Google Planilhas, Gmail e muitos outros sistemas. Confirmamos isso no diagnóstico, antes de qualquer compromisso.",
  },
  {
    pergunta: "E se a automação falhar?",
    resposta:
      "Os fluxos são montados com validações e avisos de falha. No acompanhamento, monitoramos e ajustamos o que for preciso.",
  },
  {
    pergunta: "Quanto custa uma automação?",
    resposta: `Depende do tamanho do fluxo. Enviamos a proposta depois do diagnóstico. Para quem também precisa de site, há a promoção ${promocao.titulo.toLowerCase()} por ${promocao.preco}.`,
  },
  {
    pergunta: "Vocês atendem fora de Ribeirão Preto?",
    resposta: "Sim. O atendimento presencial é em Ribeirão Preto, e o remoto, em todo o Brasil.",
  },
  {
    pergunta: "O domínio e a hospedagem ficam no meu nome?",
    resposta:
      "Sim. Quando fazemos o seu site, domínio e hospedagem ficam no seu nome, para que eles sejam sempre seus.",
  },
];
---

<section aria-labelledby="faq-titulo" class="bg-fundo">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-marca-texto uppercase">Dúvidas</p>
      <h2 id="faq-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
        Perguntas frequentes
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-suave">
        Não encontrou o que procurava?{" "}
        <a href="/contato/" class="font-bold text-marca-texto underline decoration-marca-texto/40 underline-offset-4 hover:text-texto">
          Fale com a gente</a
        >.
      </p>
    </div>

    <div class="divide-y divide-borda border-y border-borda">
      {
        perguntas.map((p) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg py-5 text-left text-lg font-bold [&::-webkit-details-marker]:hidden">
              {p.pergunta}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-destaque text-marca-texto transition-transform group-open:rotate-45" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pr-12 pb-6 leading-relaxed text-suave">{p.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
