---
// Topo das páginas internas (identidade V4). O conteúdo extra, como atalhos, entra pelo slot.
import RedeNos from "./RedeNos.astro";

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="relative overflow-hidden bg-grafite text-nevoa">
  <RedeNos cor="chama" class="absolute inset-0 h-full w-full opacity-80" />
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm font-bold tracking-[0.18em] text-brasa uppercase">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">
      {title}
    </h1>
    {text && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-areia">{text}</p>}
    <slot />
  </div>
</section>
