---
// Elemento gráfico da marca V4: curvas finas em laranja e âmbar, sempre nas bordas.
interface Props {
  class?: string;
}

const { class: classe = "" } = Astro.props;
const curvas = [
  ["M0 92 C35 95 60 80 100 55", "var(--color-chama)", 0.9, 1.4],
  ["M30 100 C55 85 80 70 100 30", "var(--color-faisca)", 0.6, 1.1],
  ["M0 97 C40 99 70 90 100 80", "var(--color-chama)", 0.45, 0.9],
  ["M86 0 C83 30 97 55 100 62", "var(--color-chama)", 0.55, 1.1],
  ["M92 0 C88 25 95 45 100 48", "var(--color-faisca)", 0.35, 0.9],
  ["M45 100 C70 92 90 75 100 68", "var(--color-chama)", 0.3, 0.9],
] as const;
---

<svg class={`pointer-events-none ${classe}`} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
  {
    curvas.map(([d, cor, opacidade, espessura]) => (
      <path d={d} fill="none" stroke={cor} stroke-opacity={opacidade} stroke-width={espessura} vector-effect="non-scaling-stroke" stroke-linecap="round" />
    ))
  }
</svg>
