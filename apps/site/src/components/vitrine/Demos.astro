---
// Demonstrações dos componentes da vitrine. Cada <template data-demo="id"> é clonado na janela
// de demonstração; a cor (--c) e o estilo (data-estilo) escolhidos pelo visitante são aplicados
// ao quadro. Conteúdo é de exemplo e assim é identificado na janela.
---

<template data-demo="banner">
  <section class="relative overflow-hidden bg-[var(--c-escuro)] px-6 py-14 text-white sm:px-10 sm:py-20">
    <div class="absolute -top-16 -right-16 h-56 w-56 rounded-full bg-white/15" aria-hidden="true"></div>
    <div class="absolute -bottom-20 left-1/3 h-40 w-40 rounded-full bg-black/10" aria-hidden="true"></div>
    <p class="relative text-sm font-bold tracking-widest uppercase opacity-85">Padaria Exemplo</p>
    <h2 class="d-titulo relative mt-3 max-w-md text-3xl leading-tight font-extrabold sm:text-4xl">Pão quentinho todos os dias, feito no bairro</h2>
    <p class="relative mt-3 max-w-md opacity-90">Encomendas para festas e cafés da manhã. Retire na loja ou receba em casa.</p>
    <div class="relative mt-7 flex flex-wrap gap-3">
      <a href="#" class="d-botao bg-white px-5 py-3 font-bold text-[var(--c-escuro)]" data-sem-acao>Fazer encomenda</a>
      <a href="#" class="d-botao border border-white/60 px-5 py-3 font-bold" data-sem-acao>Ver cardápio</a>
    </div>
  </section>
</template>

<template data-demo="faq">
  <section class="px-6 py-10 sm:px-10">
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Perguntas frequentes</h2>
    <div class="mt-6 space-y-3">
      <details class="d-cartao border border-slate-200 bg-white p-4" open>
        <summary class="cursor-pointer font-bold text-slate-900 marker:text-[var(--c-escuro)]">Vocês fazem entrega?</summary>
        <p class="mt-2 text-slate-600">Sim, entregamos no bairro de segunda a sábado, das 8h às 18h.</p>
      </details>
      <details class="d-cartao border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-bold text-slate-900 marker:text-[var(--c-escuro)]">Aceitam encomendas para festas?</summary>
        <p class="mt-2 text-slate-600">Aceitamos, com pelo menos dois dias de antecedência.</p>
      </details>
      <details class="d-cartao border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-bold text-slate-900 marker:text-[var(--c-escuro)]">Quais formas de pagamento?</summary>
        <p class="mt-2 text-slate-600">Pix, cartão de crédito e débito.</p>
      </details>
    </div>
  </section>
</template>

<template data-demo="antes-depois">
  <section class="px-6 py-10 sm:px-10">
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Antes e depois</h2>
    <p class="mt-1 text-slate-600">Arraste o controle para comparar.</p>
    <div class="d-cartao antes-depois relative mt-6 aspect-[16/9] overflow-hidden select-none" style="--pos: 50%">
      <div class="absolute inset-0 grid place-items-center bg-gradient-to-br from-slate-400 to-slate-600 text-2xl font-extrabold text-white/90">ANTES</div>
      <div class="absolute inset-0 grid place-items-center bg-[var(--c-escuro)] text-2xl font-extrabold text-white [clip-path:inset(0_0_0_var(--pos))]">DEPOIS</div>
      <div class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-1 -translate-x-1/2 bg-white shadow" aria-hidden="true"></div>
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Comparar antes e depois"
        class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
        data-antes-depois
      />
    </div>
  </section>
</template>

<template data-demo="whatsapp">
  <section class="relative min-h-72 bg-slate-50 px-6 py-10 sm:px-10">
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Botão de WhatsApp</h2>
    <p class="mt-2 max-w-sm text-slate-600">
      Fica no canto da tela em todas as páginas. Um toque abre a conversa com uma mensagem pronta.
    </p>
    <div class="d-cartao mt-6 max-w-xs border border-slate-200 bg-white p-4 text-sm text-slate-700 shadow-sm">
      <p class="font-bold text-slate-900">Padaria Exemplo</p>
      <p class="mt-1">Olá! Vim pelo site e gostaria de fazer uma encomenda.</p>
    </div>
    <a
      href="#"
      data-sem-acao
      class="absolute right-6 bottom-6 grid h-16 w-16 place-items-center rounded-full bg-[#25D366] text-white shadow-lg ring-4 ring-white"
      aria-label="Botão de WhatsApp de exemplo"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
      </svg>
    </a>
  </section>
</template>

<template data-demo="beneficios">
  <section class="px-6 py-10 sm:px-10">
    <h2 class="d-titulo text-center text-2xl font-extrabold text-slate-900">Por que escolher a Padaria Exemplo</h2>
    <ul class="mt-8 grid gap-5 sm:grid-cols-3">
      <li class="d-cartao bg-[var(--c)]/8 p-6 text-center">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-[var(--c-escuro)] text-white">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
        </span>
        <h3 class="mt-4 text-lg font-extrabold text-slate-900">Feito no dia</h3>
        <p class="mt-1.5 text-slate-600">Fornadas desde as 5h da manhã, para tudo chegar fresquinho.</p>
      </li>
      <li class="d-cartao bg-[var(--c)]/8 p-6 text-center">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-[var(--c-escuro)] text-white">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3ZM9 12l2 2 4-4"></path></svg>
        </span>
        <h3 class="mt-4 text-lg font-extrabold text-slate-900">Ingredientes selecionados</h3>
        <p class="mt-1.5 text-slate-600">Farinha de qualidade e receitas da família.</p>
      </li>
      <li class="d-cartao bg-[var(--c)]/8 p-6 text-center">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-[var(--c-escuro)] text-white">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path></svg>
        </span>
        <h3 class="mt-4 text-lg font-extrabold text-slate-900">Entrega no bairro</h3>
        <p class="mt-1.5 text-slate-600">Peça pelo WhatsApp e receba em casa.</p>
      </li>
    </ul>
  </section>
</template>

<template data-demo="servicos">
