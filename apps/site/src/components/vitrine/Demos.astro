<template data-demo="galeria">
  <section class="relative px-6 py-10 sm:px-10" data-galeria>
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Nossos produtos</h2>
    <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoria">
      <button type="button" data-filtro="todos" aria-pressed="true" class="d-botao border border-slate-300 px-4 py-1.5 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Todos</button>
      <button type="button" data-filtro="paes" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-1.5 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Pães</button>
      <button type="button" data-filtro="doces" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-1.5 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Doces</button>
      <button type="button" data-filtro="salgados" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-1.5 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Salgados</button>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <li data-categoria="paes"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[color-mix(in_srgb,var(--c)_85%,black)] p-3 text-left font-bold text-white">Pão de fermentação natural</button></li>
      <li data-categoria="doces"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[color-mix(in_srgb,var(--c)_55%,white)] p-3 text-left font-bold text-slate-900">Bolo de cenoura</button></li>
      <li data-categoria="salgados"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[color-mix(in_srgb,var(--c)_35%,#334155)] p-3 text-left font-bold text-white">Coxinha de frango</button></li>
      <li data-categoria="paes"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[color-mix(in_srgb,var(--c)_70%,white)] p-3 text-left font-bold text-slate-900">Pão integral</button></li>
      <li data-categoria="doces"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[var(--c-escuro)] p-3 text-left font-bold text-white">Sonho de creme</button></li>
      <li data-categoria="salgados"><button type="button" data-ampliar class="d-cartao grid aspect-square w-full place-items-end overflow-hidden bg-[color-mix(in_srgb,var(--c)_25%,white)] p-3 text-left font-bold text-slate-900">Pão de queijo</button></li>
    </ul>
    <div data-lightbox hidden class="absolute inset-0 z-10 place-items-center bg-slate-950/85 p-6 [&:not([hidden])]:grid" role="dialog" aria-modal="true" aria-label="Imagem ampliada">
      <div class="w-full max-w-md">
        <div data-lightbox-imagem class="d-cartao grid aspect-[4/3] place-items-end p-5 text-xl font-extrabold"></div>
        <button type="button" data-fechar-lightbox class="d-botao mt-4 w-full bg-white px-4 py-2.5 font-bold text-slate-900">Fechar imagem</button>
      </div>
    </div>
  </section>
</template>

