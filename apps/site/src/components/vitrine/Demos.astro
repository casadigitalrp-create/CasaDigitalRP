      </div>
      <button type="submit" class="d-botao justify-self-start bg-[var(--c-escuro)] px-6 py-3 font-bold text-white">Enviar mensagem</button>
      <p data-demo-sucesso hidden role="status" class="d-cartao bg-emerald-50 px-4 py-3 font-semibold text-emerald-800">
        Tudo certo! Nesta demonstração nada é enviado.
      </p>
