<template data-demo="formulario">
  <section class="px-6 py-10 sm:px-10">
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Fale com a gente</h2>
    <p class="mt-1 text-slate-600">Responderemos pelo WhatsApp ou e-mail.</p>
    <form data-demo-form novalidate class="mt-6 grid max-w-lg gap-4">
      <div>
        <label for="demo-nome" class="font-bold text-slate-900">Nome</label>
        <input id="demo-nome" name="nome" required autocomplete="off" aria-describedby="demo-erro-nome" class="d-cartao mt-1.5 block w-full border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-[var(--c)] focus:outline-none" />
        <p id="demo-erro-nome" hidden class="mt-1 text-sm font-semibold text-red-700">Informe o seu nome.</p>
      </div>
      <div>
        <label for="demo-telefone" class="font-bold text-slate-900">WhatsApp</label>
        <input id="demo-telefone" name="telefone" inputmode="tel" placeholder="(16) 99999-9999" autocomplete="off" data-mascara-telefone class="d-cartao mt-1.5 block w-full border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-[var(--c)] focus:outline-none" />
      </div>
      <div>
        <label for="demo-mensagem" class="font-bold text-slate-900">Mensagem</label>
        <textarea id="demo-mensagem" name="mensagem" rows="3" required aria-describedby="demo-erro-mensagem" class="d-cartao mt-1.5 block w-full border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-[var(--c)] focus:outline-none"></textarea>
