<template data-demo="agendamento">
  <section class="px-6 py-10 sm:px-10" data-agenda>
    <h2 class="d-titulo text-2xl font-extrabold text-slate-900">Agende seu horário</h2>
    <p class="mt-1 text-sm text-slate-600">Demonstração conceitual: o pedido segue pelo WhatsApp para confirmação.</p>

    <p class="mt-6 font-bold text-slate-900" id="agenda-servico">1. Serviço</p>
    <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="agenda-servico">
      <button type="button" data-opcao="servico" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Corte</button>
      <button type="button" data-opcao="servico" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Escova</button>
      <button type="button" data-opcao="servico" aria-pressed="false" class="d-botao border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 aria-pressed:border-[var(--c)] aria-pressed:bg-[var(--c-escuro)] aria-pressed:text-white">Manicure</button>
    </div>

    <p class="mt-5 font-bold text-slate-900" id="agenda-dia">2. Dia</p>
    <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="agenda-dia" data-dias></div>

    <p class="mt-5 font-bold text-slate-900" id="agenda-hora">3. Horário</p>
    <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="agenda-hora">
