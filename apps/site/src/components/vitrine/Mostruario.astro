---
const cenas = [
  {
    imagem: "/vitrine/automacao_3d.jpg",
    titulo: "Automação",
    texto: "Formulários e fluxos para organizar solicitações.",
  },
  {
    imagem: "/vitrine/integracao_3d.jpg",
    titulo: "Integração",
    texto: "Conexões entre site, planilhas e sistemas.",
  },
  {
    imagem: "/vitrine/ia_analise_3d.jpg",
    titulo: "Análise com IA",
    texto: "Qualificação assistida, sujeita a validação humana.",
  },
];
---

<section class="bg-white px-4 py-16 text-marinho sm:px-6" aria-labelledby="mostruario-titulo">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-bold tracking-widest text-azul-texto uppercase">Demonstrações conceituais</p>
    <h2 id="mostruario-titulo" class="mt-3 text-3xl font-extrabold">Componentes que podem fazer parte do seu site</h2>
    <p class="mt-3 max-w-3xl text-marinho/75">Estas imagens e interações mostram possibilidades. Não representam projetos entregues a clientes.</p>

    <div class="mt-12 rounded-3xl bg-marinho p-5 text-white sm:p-10" id="coverflow" aria-label="Carrossel 3D de componentes">
      <div class="flex items-center justify-between gap-3"><h3 class="text-xl font-extrabold">Carrossel 3D</h3><p id="coverflow-status" class="text-sm text-white/70" aria-live="polite"></p></div>
      <div class="coverflow-palco relative mx-auto mt-6 h-[18rem] max-w-3xl overflow-hidden sm:h-[23rem]">
        {cenas.map((cena, i) => <button type="button" class="coverflow-card absolute top-4 left-1/2 w-[14rem] -translate-x-1/2 overflow-hidden rounded-2xl border border-white/20 bg-marinho-claro text-left shadow-2xl sm:w-[17rem]" data-indice={i} aria-label={`Ver ${cena.titulo}`}><img src={cena.imagem} alt="" loading="lazy" class="h-40 w-full object-cover sm:h-52" /><span class="block p-4"><strong class="block text-lg">{cena.titulo}</strong><span class="text-sm text-white/70">{cena.texto}</span></span></button>)}
      </div>
      <div class="mt-4 flex justify-center gap-3"><button type="button" id="coverflow-anterior" class="rounded-full border border-white/35 px-5 py-2 font-bold" aria-label="Componente anterior">←</button><button type="button" id="coverflow-proximo" class="rounded-full border border-white/35 px-5 py-2 font-bold" aria-label="Próximo componente">→</button></div>
    </div>

    <div class="mt-12" aria-labelledby="cards-titulo">
      <div class="flex items-center justify-between gap-3"><h3 id="cards-titulo" class="text-2xl font-extrabold">Carrossel horizontal de cards</h3><div class="flex gap-2"><button id="cards-anterior" type="button" class="rounded-full border border-marinho/25 px-4 py-2" aria-label="Cards anteriores">←</button><button id="cards-proximo" type="button" class="rounded-full border border-marinho/25 px-4 py-2" aria-label="Próximos cards">→</button></div></div>
      <div id="trilha-cards" class="mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-4">
        {[
          ["Cabeçalhos", "Navegação clara e chamada principal."], ["Apresentação", "Seções para explicar a proposta do negócio."],
          ["Serviços", "Cards organizados por categoria."], ["FAQ", "Respostas que abrem e fecham."],
          ["Formulários", "Coleta de dados com consentimento."], ["Catálogos", "Produtos e serviços com filtros."],
          ["Chamadas para ação", "Próximo passo visível em cada seção."], ["WhatsApp", "Conversa com contexto preenchido."],
        ].map(([titulo, texto]) => <article class="min-w-[15rem] max-w-[17rem] flex-1 snap-start rounded-2xl border border-marinho/10 bg-[#f4f9fd] p-6"><h4 class="text-lg font-extrabold">{titulo}</h4><p class="mt-2 text-marinho/70">{texto}</p></article>)}
      </div>
    </div>

    <div class="mt-12" aria-labelledby="galeria-titulo"><h3 id="galeria-titulo" class="text-2xl font-extrabold">Galeria com ampliação</h3><p class="mt-2 text-marinho/70">Imagens de exemplo para visualizar o componente.</p><div class="mt-5 grid gap-4 sm:grid-cols-3">{cenas.map((cena, i) => <button type="button" class="galeria-item overflow-hidden rounded-2xl text-left ring-1 ring-marinho/10 hover:ring-azul-medio" data-indice={i} aria-label={`Ampliar ${cena.titulo}`}><img src={cena.imagem} alt={`Imagem demonstrativa de ${cena.titulo}`} loading="lazy" class="aspect-[4/3] w-full object-cover" /><span class="block p-3 font-bold">{cena.titulo}</span></button>)}</div></div>
    <p class="mt-10"><a href="/catalogo/" class="inline-block rounded-full bg-marinho px-7 py-3 font-bold text-white hover:bg-azul-medio">Escolher no Catálogo</a></p>
  </div>
</section>

<dialog id="galeria-dialogo" class="m-auto max-h-[90vh] max-w-[min(92vw,65rem)] rounded-2xl bg-marinho p-4 text-white backdrop:bg-black/80" aria-label="Imagem ampliada"><div class="flex justify-between gap-4"><strong id="galeria-legenda"></strong><button type="button" id="galeria-fechar" class="rounded-full border border-white/40 px-3 py-1" aria-label="Fechar imagem">Fechar ✕</button></div><img id="galeria-imagem" src="" alt="" class="mt-3 max-h-[65vh] w-full object-contain" /><div class="mt-3 flex justify-center gap-3"><button id="galeria-anterior" type="button" class="rounded-full border border-white/40 px-4 py-2">← Anterior</button><button id="galeria-proximo" type="button" class="rounded-full border border-white/40 px-4 py-2">Próxima →</button></div></dialog>

<script>
  const cenas = [
    { imagem: "/vitrine/automacao_3d.jpg", titulo: "Automação" },
    { imagem: "/vitrine/integracao_3d.jpg", titulo: "Integração" },
    { imagem: "/vitrine/ia_analise_3d.jpg", titulo: "Análise com IA" },
  ];
  const cards = [...document.querySelectorAll<HTMLElement>(".coverflow-card")];
  let atual = 0;
  function mostrar() {
    cards.forEach((card, i) => {
      const deslocamento = (i - atual + cards.length) % cards.length;
      const posicao = deslocamento === cards.length - 1 ? -1 : deslocamento;
      card.style.transform = `translateX(calc(-50% + ${posicao * 78}%)) rotateY(${-posicao * 35}deg) scale(${posicao === 0 ? 1 : 0.82})`;
      card.style.opacity = Math.abs(posicao) > 1 ? "0" : "1";
      card.style.zIndex = String(10 - Math.abs(posicao));
      card.setAttribute("aria-hidden", posicao === 0 ? "false" : "true");
      card.tabIndex = posicao === 0 ? 0 : -1;
    });
    document.getElementById("coverflow-status")!.textContent = `${atual + 1} de ${cards.length}: ${cenas[atual]!.titulo}`;
  }
  function navegar(delta: number) { atual = (atual + delta + cards.length) % cards.length; mostrar(); }
  document.getElementById("coverflow-anterior")!.addEventListener("click", () => navegar(-1));
  document.getElementById("coverflow-proximo")!.addEventListener("click", () => navegar(1));
  cards.forEach((card, i) => card.addEventListener("click", () => { atual = i; mostrar(); }));
  document.getElementById("coverflow")!.addEventListener("keydown", (e) => { if (e.key === "ArrowLeft") navegar(-1); if (e.key === "ArrowRight") navegar(1); });
  mostrar();
  const trilha = document.getElementById("trilha-cards")!;
  document.getElementById("cards-anterior")!.addEventListener("click", () => trilha.scrollBy({ left: -300, behavior: "smooth" }));
  document.getElementById("cards-proximo")!.addEventListener("click", () => trilha.scrollBy({ left: 300, behavior: "smooth" }));
  const dialogo = document.getElementById("galeria-dialogo") as HTMLDialogElement;
  let imagemAtual = 0;
  let origem: HTMLElement | null = null;
  function exibirImagem() { const cena = cenas[imagemAtual]!; (document.getElementById("galeria-imagem") as HTMLImageElement).src = cena.imagem; (document.getElementById("galeria-imagem") as HTMLImageElement).alt = `Imagem demonstrativa de ${cena.titulo}`; document.getElementById("galeria-legenda")!.textContent = cena.titulo; }
  document.querySelectorAll<HTMLElement>(".galeria-item").forEach((item, i) => item.addEventListener("click", () => { origem = item; imagemAtual = i; exibirImagem(); dialogo.showModal(); }));
  document.getElementById("galeria-fechar")!.addEventListener("click", () => dialogo.close());
  document.getElementById("galeria-anterior")!.addEventListener("click", () => { imagemAtual = (imagemAtual - 1 + cenas.length) % cenas.length; exibirImagem(); });
  document.getElementById("galeria-proximo")!.addEventListener("click", () => { imagemAtual = (imagemAtual + 1) % cenas.length; exibirImagem(); });
  dialogo.addEventListener("keydown", (e) => { if (e.key === "ArrowLeft") { imagemAtual = (imagemAtual - 1 + cenas.length) % cenas.length; exibirImagem(); } if (e.key === "ArrowRight") { imagemAtual = (imagemAtual + 1) % cenas.length; exibirImagem(); } });
  dialogo.addEventListener("close", () => origem?.focus());
</script>

<style>.coverflow-palco { perspective: 900px; } .coverflow-card { transition: transform .45s ease, opacity .45s ease; transform-style: preserve-3d; } @media (prefers-reduced-motion: reduce) { .coverflow-card { transition: none; } }</style>
