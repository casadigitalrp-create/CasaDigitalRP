---
import { ctaPrincipal, whatsappUrl } from "../data/site";
import LinhasFluindo from "./LinhasFluindo.astro";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Qual tarefa você quer tirar das suas costas?",
  text = "Conte no formulário ou chame no WhatsApp. Em uma conversa, mostramos o que dá para automatizar.",
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-grafite text-nevoa">
  <LinhasFluindo class="absolute inset-0 -z-10 h-full w-full" />
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-28">
    <h2 class="text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-areia">{text}</p>
    <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
      <a href={ctaPrincipal.href} class="rounded-full bg-chama px-7 py-3.5 text-lg font-bold text-grafite transition-colors hover:bg-faisca">
        {ctaPrincipal.label}
      </a>
      {
        whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-white/25 px-7 py-3.5 text-lg font-bold transition-colors hover:border-brasa hover:text-brasa"
          >
            Falar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
          </a>
        )
      }
    </div>
  </div>
</section>
