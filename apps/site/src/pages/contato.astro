---
import PageHeader from "../components/PageHeader.astro";
import { site, whatsappUrl } from "../data/site";
import Base from "../layouts/Base.astro";

const motivos = ["Novo site", "Já tenho um site", "Créditos de atualização", "Outro assunto"];

const dicas = [
  "O que o seu negócio faz e para quem",
  "O objetivo do site: vender, receber contatos, informar...",
  "Sites que você gosta, como referência",
  "Se já tem domínio, logo e textos",
];

const campo =
  "mt-2 block w-full rounded-xl border border-marinho/20 bg-white px-4 py-3 text-marinho placeholder:text-marinho/40 focus:border-azul-medio focus:outline-none focus-visible:outline-3 focus-visible:outline-azul-medio aria-invalid:border-red-600";
const erro = "mt-2 text-[15px] font-semibold text-red-700";
const icone = "grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-marinho text-azul";
---

<Base
  title="Contato"
  description="Fale com a CasaDigitalRP pelo WhatsApp, por e-mail ou pelo formulário e tire suas dúvidas sobre a criação ou a atualização do seu site."
>
  <PageHeader
    eyebrow="Contato"
    title="Vamos conversar sobre o seu site"
    text="Fale com a gente pelo WhatsApp, por e-mail ou deixe sua mensagem no formulário. Se já sabe o que precisa, a vitrine monta a solicitação completa."
  />

  <div class="bg-[#f4f9fd] text-marinho">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1.45fr_1fr] lg:gap-10 lg:py-20">
      <!-- Formulário: prepara a mensagem e abre o aplicativo escolhido pelo visitante. -->
      <section aria-labelledby="form-titulo" class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-marinho/10 sm:p-10">
        <h2 id="form-titulo" class="text-2xl font-extrabold tracking-tight sm:text-3xl">Envie uma mensagem</h2>
        <p class="mt-2 text-marinho/70">
          Estes dados não ficam salvos no site: vão apenas na mensagem que você mesmo enviar.
        </p>

        <form id="contato" method="post" class="mt-8 space-y-6" novalidate>
          <div>
            <label for="contato-nome" class="font-bold">Seu nome <span class="text-azul-texto">(obrigatório)</span></label>
            <input id="contato-nome" name="nome" type="text" autocomplete="name" maxlength="120" required aria-describedby="erro-contato-nome" class={campo} />
            <p id="erro-contato-nome" class={erro} hidden>Informe o seu nome.</p>
          </div>

          <fieldset>
            <legend class="font-bold">Motivo do contato</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                motivos.map((m) => (
                  <label class="cursor-pointer rounded-full border-2 border-transparent bg-[#f4f9fd] px-4 py-2 text-[15px] font-semibold ring-1 ring-marinho/15 has-[:checked]:border-azul-medio has-[:checked]:bg-azul/15 has-[:checked]:ring-0 has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-azul-medio">
                    <input type="radio" name="motivo" value={m} class="sr-only" />
                    {m}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div>
            <label for="contato-mensagem" class="font-bold">Mensagem <span class="text-azul-texto">(obrigatório)</span></label>
            <textarea id="contato-mensagem" name="mensagem" rows="6" maxlength="1500" required aria-describedby="erro-contato-mensagem" placeholder="Conte como podemos ajudar." class={campo}></textarea>
            <p id="erro-contato-mensagem" class={erro} hidden>Escreva a sua mensagem.</p>
          </div>

          <div>
            <label class="flex cursor-pointer items-start gap-3">
              <input id="contato-consentimento" name="consentimento" type="checkbox" required aria-describedby="erro-contato-consentimento" class="mt-1 h-5 w-5 shrink-0 cursor-pointer rounded accent-azul-medio" />
              <span class="text-[15px] leading-relaxed text-marinho/80">
                Li a{" "}
                <a href="/politica-de-privacidade/" target="_blank" rel="noopener" class="font-bold text-azul-texto underline underline-offset-4 hover:text-marinho">
                  Política de Privacidade<span class="sr-only"> (abre em nova aba)</span></a
                > e concordo com o uso destes dados para responder ao meu contato.{" "}
                <span class="text-azul-texto">(obrigatório)</span>
              </span>
            </label>
            <p id="erro-contato-consentimento" class={erro} hidden>Para enviar, marque a concordância com a Política de Privacidade.</p>
          </div>

          <div class="rounded-2xl bg-marinho/[0.04] p-4 text-[15px] leading-relaxed text-marinho/75">
            Ao enviar, abrimos o seu WhatsApp ou o seu aplicativo de e-mail com a mensagem pronta. O
            envio só acontece quando você confirmar por lá.
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <button type="submit" name="canal" value="whatsapp" class="rounded-full bg-[#25D366] px-6 py-3.5 text-lg font-bold text-marinho transition hover:brightness-110">
              Enviar pelo WhatsApp
            </button>
            <button type="submit" name="canal" value="email" class="rounded-full bg-marinho px-6 py-3.5 text-lg font-bold text-white transition-colors hover:bg-azul-medio">
              Enviar por e-mail
            </button>
            <button type="submit" name="canal" value="copiar" class="rounded-full border border-marinho/20 px-6 py-3.5 text-lg font-bold transition-colors hover:border-azul-medio hover:text-azul-texto">
              Copiar mensagem
            </button>
          </div>
          <p id="status-contato" class="hidden rounded-xl bg-azul/15 px-4 py-3 text-[15px]" role="status"></p>
        </form>
      </section>

      <div class="space-y-6">
        <section aria-labelledby="canais-titulo" class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-marinho/10 sm:p-8">
          <h2 id="canais-titulo" class="text-xl font-extrabold">Canais diretos</h2>
          <ul class="mt-6 space-y-6">
            {
              whatsappUrl && (
                <li class="flex gap-4">
                  <span class={icone}>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
                    </svg>
                  </span>
                  <span>
                    <span class="block text-sm font-bold text-marinho/60">WhatsApp</span>
                    <span class="block text-lg font-extrabold">{site.whatsappLabel}</span>
                    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-bold text-azul-texto underline underline-offset-4 hover:text-marinho">
                      Conversar agora<span class="sr-only"> pelo WhatsApp (abre em nova aba)</span>
                    </a>
                  </span>
                </li>
              )
            }
            <li class="flex gap-4">
              <span class={icone}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 6h16v12H4zM4 7l8 6 8-6" />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-marinho/60">E-mail</span>
                <span class="block text-lg font-extrabold break-all">{site.email}</span>
                <span class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
                  <a href={`mailto:${site.email}`} class="font-bold text-azul-texto underline underline-offset-4 hover:text-marinho">Escrever e-mail</a>
                  <button type="button" data-copiar-email={site.email} class="font-bold text-azul-texto underline underline-offset-4 hover:text-marinho">
                    Copiar endereço
                  </button>
                </span>
                <span id="status-email" class="mt-1 block text-sm font-semibold text-emerald-700" role="status"></span>
              </span>
            </li>
            <li class="flex gap-4">
              <span class={icone}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21ZM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-bold text-marinho/60">Cidade</span>
                <span class="block text-lg font-extrabold">{site.city}</span>
              </span>
            </li>
          </ul>
        </section>

        <section aria-labelledby="vitrine-titulo" class="relative overflow-hidden rounded-3xl bg-marinho p-6 text-white sm:p-8">
          <div class="absolute -top-16 -right-16 h-48 w-48 rounded-full bg-azul-medio/30 blur-2xl" aria-hidden="true"></div>
          <h2 id="vitrine-titulo" class="relative text-xl font-extrabold">Quer uma proposta?</h2>
          <p class="relative mt-2 leading-relaxed text-white/75">
            Na vitrine você escolhe o modelo e os componentes e envia tudo de uma vez.
          </p>
          <a href="/vitrine/" class="relative mt-5 inline-block rounded-full bg-azul px-5 py-2.5 font-bold text-marinho transition-colors hover:bg-white">
            Montar minha solicitação
          </a>
        </section>

        <section aria-labelledby="dicas-titulo" class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-marinho/10 sm:p-8">
          <h2 id="dicas-titulo" class="text-xl font-extrabold">Para agilizar, conte na mensagem</h2>
          <ul class="mt-4 space-y-2.5">
            {
              dicas.map((d) => (
                <li class="flex gap-3 text-marinho/80">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-azul-medio" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  {d}
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>

  <script type="application/json" id="contato-dados" set:html={JSON.stringify({ whatsapp: site.whatsapp, email: site.email })} />
</Base>

<script>
  import { copiarTexto, juntar, linha, linkEmail, linkWhatsapp, type Canal } from "../lib/mensagem";

  const form = document.getElementById("contato") as HTMLFormElement;
  const status = document.getElementById("status-contato")!;
  const destino: { whatsapp: string; email: string } = JSON.parse(
    document.getElementById("contato-dados")!.textContent!,
  );

  const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement;
  const motivo = () => form.querySelector<HTMLInputElement>('input[name="motivo"]:checked')?.value ?? "";

  function texto(canal: Canal) {
    return juntar([
      "Olá! Vim pela página de contato do site da CasaDigitalRP.",
      "",
      linha(canal, "Nome", campo("nome").value),
      linha(canal, "Motivo", motivo()),
      linha(canal, "Mensagem", campo("mensagem").value),
    ]);
  }

  // Validação local: marca cada campo obrigatório e leva o foco ao primeiro com problema.
  function validar(): boolean {
    let primeiro: HTMLInputElement | null = null;
    for (const nome of ["nome", "mensagem", "consentimento"]) {
      const el = campo(nome);
      const invalido = el.type === "checkbox" ? !el.checked : !el.value.trim();
      if (invalido) el.setAttribute("aria-invalid", "true");
      else el.removeAttribute("aria-invalid");
      document.getElementById(el.getAttribute("aria-describedby")!)!.hidden = !invalido;
      if (invalido && !primeiro) primeiro = el;
    }
    (primeiro as HTMLInputElement | null)?.focus();
    return primeiro === null;
  }

  function avisar(mensagem: string) {
    status.textContent = mensagem;
    status.classList.remove("hidden");
  }

  // Ao corrigir um campo, o aviso de erro dele some.
  form.addEventListener("input", (e) => {
    const el = e.target as HTMLInputElement;
    const ok = el.type === "checkbox" ? el.checked : el.value.trim() !== "";
    if (ok && el.hasAttribute("aria-invalid")) {
      el.removeAttribute("aria-invalid");
      document.getElementById(el.getAttribute("aria-describedby")!)!.hidden = true;
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.classList.add("hidden");
    if (!validar()) return;
    const canal = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value ?? "whatsapp";
    if (canal === "whatsapp") {
      window.open(linkWhatsapp(destino.whatsapp, texto("whatsapp")), "_blank", "noopener");
      avisar("Abrimos o WhatsApp com a sua mensagem. Confira e toque em enviar por lá para concluir.");
    } else if (canal === "email") {
      const assunto = `Contato pelo site${motivo() ? ` – ${motivo()}` : ""}`;
      location.href = linkEmail(destino.email, assunto, texto("email"));
      avisar("Abrimos o seu aplicativo de e-mail com a mensagem. Confira e envie por lá para concluir.");
    } else {
      const ok = await copiarTexto(texto("email"));
      avisar(
        ok
          ? `Mensagem copiada. Cole onde preferir ou envie para ${destino.email}.`
          : "Não foi possível copiar automaticamente. Use os botões de WhatsApp ou e-mail.",
      );
    }
  });

  document.querySelector<HTMLButtonElement>("[data-copiar-email]")!.addEventListener("click", async (e) => {
    const ok = await copiarTexto((e.currentTarget as HTMLElement).dataset.copiarEmail!);
    document.getElementById("status-email")!.textContent = ok ? "Endereço copiado." : "Não foi possível copiar.";
  });
</script>
