---
import PageHeader from "../components/PageHeader.astro";
import PreviaViva from "../components/PreviaViva.astro";
import { componentes } from "../data/componentes";
import { modelos } from "../data/modelos";
import { promocao, site } from "../data/site";
import Base from "../layouts/Base.astro";

// Depoimentos e parceiros só entram com conteúdo real e autorizado; ficam fora da escolha.
const extras = componentes.filter((c) => !["depoimentos", "parceiros"].includes(c.id));

// Miniatura do layout de cada modelo, em blocos simples.
const miniaturas: Record<string, string[]> = {
  institucional: ["h-3 w-2/3", "h-10 w-full", "grid3", "h-3 w-1/2"],
  catalogo: ["h-3 w-1/2", "grid6", "h-3 w-2/3"],
  campanha: ["h-12 w-full", "h-3 w-1/3", "h-6 w-1/2"],
  agendamento: ["h-3 w-2/3", "h-8 w-full", "cal", "h-3 w-1/2"],
};

const dados = {
  whatsapp: site.whatsapp,
  email: site.email,
  modelos: Object.fromEntries(
    modelos.map((m) => [m.slug, { titulo: m.titulo, componentes: m.componentes }]),
  ),
  componentes: Object.fromEntries(componentes.map((c) => [c.id, c.nome])),
};

const perguntas = [
  [
    "O domínio e a hospedagem ficam no meu nome?",
    "Sim. Tudo fica no seu nome, no mesmo modelo usado pela CasaDigitalRP. O domínio é pago por você diretamente ao registro.",
  ],
  [
    "O que a automação de e-mail faz?",
    "Cada pedido feito no formulário do seu site vira um e-mail para você e uma linha na sua planilha. Nada se perde no meio das mensagens.",
  ],
  [
    "Posso mudar o site depois que ele estiver no ar?",
    "Pode. Combinamos as alterações e avaliamos cada pedido com você.",
  ],
  [
    "Preciso escolher tudo agora?",
    "Não. Escolha o que já sabe; o resto a gente define junto na conversa.",
  ],
];

const campo =
  "mt-2 block w-full rounded-xl border border-borda bg-superficie px-4 py-3 text-texto placeholder:text-suave/60 focus:border-marca focus:outline-3 focus:outline-marca";
---

<Base title="Sites" description={`Site completo + automação de e-mail por ${promocao.preco}: site pensado para o celular, WhatsApp e formulário que avisa você por e-mail. Domínio e hospedagem no seu nome.`}>
  <PageHeader eyebrow="Promoção" title="Seu site pronto e já trabalhando sozinho" text={`${promocao.titulo}. Domínio e hospedagem no seu nome.`}>
    <div class="mt-8 flex flex-wrap items-center gap-6">
      <p class="text-5xl font-extrabold text-brasa">{promocao.preco}</p>
      <a href="#pedido" class="rounded-full bg-chama px-7 py-3.5 text-lg font-bold text-grafite transition-colors hover:bg-faisca">Quero o meu</a>
    </div>
  </PageHeader>

  <PreviaViva />

  <!-- O que vem no pacote -->
  <section aria-labelledby="pacote-titulo" class="bg-grafite text-nevoa">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-brasa uppercase">O que vem no pacote</p>
        <h2 id="pacote-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">Tudo para o seu negócio aparecer e ser chamado</h2>
        <ul class="mt-8 space-y-4">
          {
            promocao.itens.map((item) => (
              <li class="flex gap-3 text-lg leading-relaxed">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-chama" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-areia">{promocao.observacao}</p>
      </div>
      <figure class="rounded-3xl border border-white/10 bg-grafite-claro p-7" aria-label="Automação incluída: formulário, e-mail e planilha">
        <figcaption class="text-sm font-bold text-areia">A automação que vem junto</figcaption>
        <ol class="relative mt-6 space-y-5">
          <span class="absolute top-3 bottom-3 left-[11px] w-0.5 bg-chama/40" aria-hidden="true" />
          {
            [
              ["Cliente preenche o formulário do site", "anel"],
              ["Você recebe o pedido por e-mail", "cheio"],
              ["O pedido entra na sua planilha", "anel"],
            ].map(([texto, tipo]) => (
              <li class="relative flex items-center gap-4">
                <span class={`relative h-6 w-6 shrink-0 rounded-full ${tipo === "anel" ? "border-[3px] border-chama bg-grafite-claro" : "bg-chama"}`} aria-hidden="true" />
                <span class="flex-1 rounded-xl border border-white/10 bg-grafite px-4 py-3 font-semibold">{texto}</span>
              </li>
            ))
          }
        </ol>
      </figure>
    </div>
  </section>

  <!-- Pedido em 3 passos -->
  <section id="pedido" aria-labelledby="pedido-titulo" class="scroll-mt-20 bg-fundo">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-24">
      <p class="text-sm font-bold tracking-[0.18em] text-marca-texto uppercase">Peça o seu</p>
      <h2 id="pedido-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">Monte o seu site em 3 passos</h2>
      <div class="mt-8" aria-hidden="true">
        <div class="h-2 overflow-hidden rounded-full bg-borda"><div id="progresso" class="h-full w-1/3 rounded-full bg-marca transition-all duration-500"></div></div>
      </div>
      <p id="passo-atual" class="mt-3 text-sm font-bold text-suave" aria-live="polite">Passo 1 de 3</p>

      <form id="pedido-form" class="mt-8" novalidate>
        <fieldset data-passo="1" class="space-y-6">
          <legend class="text-2xl font-extrabold">1. Escolha o modelo</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            {
              modelos.map((m) => (
                <label class="flex cursor-pointer gap-4 rounded-2xl border-2 border-borda bg-superficie p-5 transition-colors hover:border-marca/60 has-[:checked]:border-marca has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-marca">
                  <input type="radio" name="modelo" value={m.slug} class="sr-only" />
                  <span class="flex h-24 w-20 shrink-0 flex-col gap-1.5 rounded-lg border border-borda bg-fundo p-2" aria-hidden="true">
                    {(miniaturas[m.slug] ?? []).map((b) =>
                      b === "grid3" ? (
                        <span class="grid grid-cols-3 gap-1"><span class="h-4 rounded-sm bg-marca/30" /><span class="h-4 rounded-sm bg-marca/30" /><span class="h-4 rounded-sm bg-marca/30" /></span>
                      ) : b === "grid6" ? (
                        <span class="grid grid-cols-3 gap-1">{Array.from({ length: 6 }, () => <span class="h-3.5 rounded-sm bg-marca/30" />)}</span>
                      ) : b === "cal" ? (
                        <span class="grid grid-cols-4 gap-0.5">{Array.from({ length: 8 }, (_, i) => <span class={`h-2 rounded-sm ${i === 5 ? "bg-marca" : "bg-marca/25"}`} />)}</span>
                      ) : (
                        <span class={`block rounded-sm bg-marca/40 ${b}`} />
                      ),
                    )}
                  </span>
                  <span>
                    <span class="block text-lg font-extrabold">{m.titulo}</span>
                    <span class="mt-1 block text-[15px] leading-relaxed text-suave">{m.resumo}</span>
                    <span class="mt-2 block text-sm font-bold text-marca-texto">Ideal para: {m.idealPara}</span>
                  </span>
                </label>
              ))
            }
          </div>
          <p id="erro-modelo" class="hidden font-bold text-marca-texto" role="alert">Escolha um modelo para continuar.</p>
          <button type="button" data-avancar="2" class="rounded-full bg-marca px-7 py-3 font-bold text-grafite transition-colors hover:bg-chama">Continuar</button>
        </fieldset>

        <fieldset data-passo="2" class="space-y-6">
          <legend class="text-2xl font-extrabold">2. Quer algo a mais?</legend>
          <p class="text-suave">Já marcamos o que costuma vir no modelo escolhido. Tire ou acrescente à vontade.</p>
          <div class="flex flex-wrap gap-3">
            {
              extras.map((c) => (
                <label class="cursor-pointer rounded-full border border-borda bg-superficie px-4 py-2 text-[15px] font-bold transition-colors hover:border-marca has-[:checked]:border-marca has-[:checked]:bg-marca has-[:checked]:text-grafite has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-marca" title={c.descricao}>
                  <input type="checkbox" name="componentes" value={c.id} class="sr-only" />
                  {c.nome}
                </label>
              ))
            }
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" data-voltar="1" class="rounded-full border border-borda px-6 py-3 font-bold hover:border-marca">Voltar</button>
            <button type="button" data-avancar="3" class="rounded-full bg-marca px-7 py-3 font-bold text-grafite transition-colors hover:bg-chama">Continuar</button>
          </div>
        </fieldset>

        <fieldset data-passo="3" class="space-y-6">
          <legend class="text-2xl font-extrabold">3. Conte sobre você</legend>
          <p class="text-suave">Só o nome é obrigatório. Os dados não ficam salvos no site: vão apenas na mensagem que você mesmo enviar.</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="nome" class="font-bold">Seu nome <span class="text-marca-texto">(obrigatório)</span></label>
              <input id="nome" name="nome" type="text" autocomplete="name" required class={campo} />
              <p id="erro-nome" class="mt-2 hidden font-bold text-marca-texto" role="alert">Conte o seu nome para a gente saber com quem vai falar.</p>
            </div>
            <div><label for="negocio" class="font-bold">Nome do negócio</label><input id="negocio" name="negocio" type="text" autocomplete="organization" class={campo} /></div>
            <div><label for="segmento" class="font-bold">Segmento</label><input id="segmento" name="segmento" type="text" placeholder="Ex.: padaria, clínica, escritório" class={campo} /></div>
            <div class="sm:col-span-2"><label for="site-atual" class="font-bold">Site atual, se tiver</label><input id="site-atual" name="siteAtual" type="url" inputmode="url" placeholder="https://" class={campo} /></div>
            <div class="sm:col-span-2"><label for="observacoes" class="font-bold">Algo mais?</label><textarea id="observacoes" name="observacoes" rows="4" placeholder="Referências, dúvidas, o que for importante para você." class={campo}></textarea></div>
          </div>
          <div class="rounded-3xl bg-grafite p-6 text-nevoa sm:p-8">
            <p class="font-extrabold">Pronto! Escolha como prefere enviar:</p>
            <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <button type="button" data-enviar="whatsapp" class="rounded-full bg-[#25D366] px-6 py-3.5 text-lg font-bold text-grafite transition hover:brightness-110">Enviar pelo WhatsApp</button>
              <button type="button" data-enviar="email" class="rounded-full bg-chama px-6 py-3.5 text-lg font-bold text-grafite transition-colors hover:bg-faisca">Enviar por e-mail</button>
              <button type="button" data-enviar="copiar" class="rounded-full border border-white/30 px-6 py-3.5 text-lg font-bold transition-colors hover:border-brasa hover:text-brasa">Copiar resumo</button>
            </div>
            <p id="status-envio" class="mt-5 hidden rounded-xl bg-white/10 px-4 py-3 text-[15px]" role="status"></p>
            <p class="mt-5 text-sm leading-relaxed text-areia">
              Os botões abrem o seu WhatsApp ou o seu e-mail com a mensagem pronta. O envio só acontece quando você confirmar por lá. Veja a nossa{" "}
              <a href="/politica-de-privacidade/" class="font-bold text-brasa underline underline-offset-4">Política de Privacidade</a>.
            </p>
          </div>
          <button type="button" data-voltar="2" class="rounded-full border border-borda px-6 py-3 font-bold hover:border-marca">Voltar</button>
        </fieldset>
      </form>
    </div>
  </section>

  <!-- Dúvidas -->
  <section aria-labelledby="duvidas-titulo" class="bg-superficie">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
      <h2 id="duvidas-titulo" class="text-3xl font-extrabold tracking-tight">Dúvidas sobre o site</h2>
      <div class="mt-8 divide-y divide-borda border-y border-borda">
        {
          perguntas.map(([p, r]) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold [&::-webkit-details-marker]:hidden">
                {p}
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-destaque text-marca-texto transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pr-12 pb-6 leading-relaxed text-suave">{r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script type="application/json" id="pedido-dados" set:html={JSON.stringify(dados)} />
</Base>

<script>
  import { copiarTexto } from "../lib/mensagem";
  import { linkEmail, linkWhatsapp, type Solicitacao, textoDaSolicitacao } from "../lib/solicitacao";

  interface Dados {
    whatsapp: string;
    email: string;
    modelos: Record<string, { titulo: string; componentes: string[] }>;
    componentes: Record<string, string>;
  }

  const dados = JSON.parse(document.getElementById("pedido-dados")?.textContent ?? "{}") as Dados;
  const form = document.getElementById("pedido-form") as HTMLFormElement;
  const passos = [...form.querySelectorAll<HTMLFieldSetElement>("[data-passo]")];
  const progresso = document.getElementById("progresso") as HTMLDivElement;
  const passoAtual = document.getElementById("passo-atual") as HTMLParagraphElement;
  const status = document.getElementById("status-envio") as HTMLParagraphElement;

  const valor = (nome: string) => (form.elements.namedItem(nome) as HTMLInputElement | null)?.value ?? "";
  const modeloEscolhido = () => form.querySelector<HTMLInputElement>('input[name="modelo"]:checked')?.value ?? "";

  // Sem JavaScript os três passos aparecem juntos; com ele, um de cada vez.
  const mostrar = (n: number, focar = true) => {
    passos.forEach((p) => {
      p.hidden = p.dataset.passo !== String(n);
    });
    progresso.style.width = `${(n / 3) * 100}%`;
    passoAtual.textContent = `Passo ${n} de 3`;
    if (focar) passos[n - 1]?.querySelector("legend")?.scrollIntoView({ behavior: "smooth", block: "center" });
  };
  mostrar(1, false);

  form.addEventListener("click", (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
    if (!alvo) return;
    if (alvo.dataset.avancar === "2" && !modeloEscolhido()) {
      document.getElementById("erro-modelo")?.classList.remove("hidden");
      return;
    }
    if (alvo.dataset.avancar) mostrar(Number(alvo.dataset.avancar));
    if (alvo.dataset.voltar) mostrar(Number(alvo.dataset.voltar));
  });

  form.addEventListener("change", (e) => {
    const alvo = e.target as HTMLInputElement;
    if (alvo.name !== "modelo") return;
    document.getElementById("erro-modelo")?.classList.add("hidden");
    const sugeridos = dados.modelos[alvo.value]?.componentes ?? [];
    for (const i of form.querySelectorAll<HTMLInputElement>('input[name="componentes"]')) i.checked = sugeridos.includes(i.value);
  });
  form.addEventListener("submit", (e) => e.preventDefault());

  const solicitacao = (): Solicitacao => ({
    modelo: dados.modelos[modeloEscolhido()]?.titulo,
    componentes: [...form.querySelectorAll<HTMLInputElement>('input[name="componentes"]:checked')].map((i) => dados.componentes[i.value] ?? i.value),
    nome: valor("nome"),
    negocio: valor("negocio"),
    segmento: valor("segmento"),
    siteAtual: valor("siteAtual"),
    observacoes: ["Promoção: site completo + automação de e-mail", valor("observacoes")].filter((v) => v.trim()).join("\n"),
  });

  for (const botao of form.querySelectorAll<HTMLButtonElement>("[data-enviar]")) {
    botao.addEventListener("click", async () => {
      if (!valor("nome").trim()) {
        document.getElementById("erro-nome")?.classList.remove("hidden");
        (form.elements.namedItem("nome") as HTMLInputElement).focus();
        return;
      }
      document.getElementById("erro-nome")?.classList.add("hidden");
      const s = solicitacao();
      if (botao.dataset.enviar === "whatsapp") window.open(linkWhatsapp(dados.whatsapp, s), "_blank", "noopener");
      if (botao.dataset.enviar === "email") location.href = linkEmail(dados.email, s);
      if (botao.dataset.enviar === "copiar") {
        const ok = await copiarTexto(textoDaSolicitacao(s, "email"));
        status.textContent = ok ? "Resumo copiado. É só colar onde preferir." : "Não foi possível copiar. Tente os outros botões.";
        status.classList.remove("hidden");
      }
    });
  }
</script>
