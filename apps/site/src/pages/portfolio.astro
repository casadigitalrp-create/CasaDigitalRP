---
import { Image } from "astro:assets";
import celular from "../assets/portfolio/cafe-aurora-celular.png";
import desktop from "../assets/portfolio/cafe-aurora-desktop.png";
import ComparativoStacks from "../components/ComparativoStacks.astro";
import Cta from "../components/Cta.astro";
import PageHeader from "../components/PageHeader.astro";
import { ctaPrincipal } from "../data/site";
import { stacks } from "../data/stacks";
import Base from "../layouts/Base.astro";

const recursosCafe = [
  "Cardápio em abas",
  "Reserva com validação",
  "Pensado para o celular",
  "Uso pelo teclado",
];
const selo =
  "inline-block self-start rounded-full px-3 py-1 text-xs font-bold tracking-wide text-marinho uppercase";
---

<Base
  title="Portfólio"
  description="Projetos de clientes autorizados e demonstrações da CasaDigitalRP, como o site do Café Aurora feito em quatro tecnologias e a vitrine de componentes interativos."
>
  <PageHeader
    eyebrow="Portfólio"
    title="Projetos e demonstrações"
    text="Aqui ficam os projetos de clientes autorizados para divulgação e as demonstrações que criamos para mostrar, na prática, como trabalhamos."
  />

  <!-- Projetos de clientes: estado inicial honesto (escopo, seção 4.4). -->
  <section aria-labelledby="clientes-titulo" class="bg-[#f4f9fd] text-marinho">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="rounded-3xl border-2 border-dashed border-azul-medio/40 bg-white px-6 py-12 text-center sm:px-12">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-marinho text-azul" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7h18v12H3zM8 7V5h8v2M3 12h18" />
          </svg>
        </span>
        <h2 id="clientes-titulo" class="mt-5 text-2xl font-extrabold tracking-tight sm:text-3xl">Projetos de clientes</h2>
        <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-marinho/75">
          Os primeiros projetos estão a caminho. Publicamos aqui somente trabalhos entregues e com
          autorização de cada cliente.
        </p>
        <a
          href={ctaPrincipal.href}
          class="mt-7 inline-block rounded-full bg-marinho px-6 py-3 font-bold text-white transition-colors hover:bg-azul-medio"
        >
          Quero que o meu seja o primeiro
        </a>
      </div>
    </div>
  </section>

  <!-- Demonstrações próprias, sempre identificadas como tal. -->
  <section aria-labelledby="demos-titulo" class="bg-white text-marinho">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-bold tracking-[0.18em] text-azul-texto uppercase">Demonstrações</p>
        <h2 id="demos-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
          Feitas pela CasaDigitalRP para mostrar na prática
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-marinho/75">
          Os negócios das demonstrações são fictícios e estão identificados como tal.
        </p>
      </div>

      <ul class="mt-12 space-y-8">
        <!-- Café Aurora -->
        <li class="grid overflow-hidden rounded-3xl bg-[#f4f9fd] ring-1 ring-marinho/10 lg:grid-cols-[1.25fr_1fr]">
          <div class="relative px-6 pt-8 pb-14 sm:px-10 sm:pt-10" aria-hidden="true">
            <div class="overflow-hidden rounded-xl bg-white shadow-xl ring-1 ring-marinho/10">
              <div class="flex items-center gap-1.5 border-b border-marinho/10 px-3 py-2">
                <span class="h-2.5 w-2.5 rounded-full bg-marinho/15"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-marinho/15"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-dourado"></span>
              </div>
              <Image src={desktop} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 90vw" class="block h-auto w-full" />
            </div>
            <div class="absolute right-4 bottom-4 w-[26%] max-w-36 overflow-hidden rounded-[1.4rem] border-[6px] border-marinho bg-marinho shadow-2xl sm:right-8">
              <Image src={celular} alt="" widths={[160, 320]} sizes="144px" class="block h-auto w-full rounded-[1rem]" />
            </div>
          </div>
          <div class="flex flex-col justify-center px-6 pb-8 sm:px-10 sm:pb-10 lg:py-10">
            <p class:list={[selo, "bg-dourado/30"]}>Demonstração · cliente fictício</p>
            <h3 class="mt-4 text-2xl font-extrabold">Café Aurora</h3>
            <p class="mt-3 leading-relaxed text-marinho/75">
              Site de uma cafeteria fictícia, com cardápio em abas e formulário de reserva com
              validação. A mesma página foi feita em quatro tecnologias para compararmos o desempenho
              de cada uma.
            </p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Recursos do Café Aurora">
              {recursosCafe.map((r) => <li class="rounded-full bg-azul/15 px-3 py-1 text-sm font-semibold text-marinho/85">{r}</li>)}
            </ul>
            <p class="mt-5 text-[15px] text-marinho/75">
              <strong class="font-bold text-marinho">Versões:</strong> {stacks.map((s) => s.nome).join(" · ")}.
              Publicação em breve.
            </p>
            <a href="#detalhes-tecnicos" data-abrir-detalhes class="mt-5 inline-flex items-center gap-1.5 self-start font-bold text-azul-texto underline decoration-azul-texto/40 underline-offset-4 hover:text-marinho">
              Ver o comparativo técnico <span aria-hidden="true">↓</span>
            </a>
          </div>
        </li>

        <!-- Vitrine de componentes -->
        <li class="grid overflow-hidden rounded-3xl bg-marinho text-white lg:grid-cols-[1fr_1.25fr]">
          <div class="flex flex-col justify-center px-6 py-8 sm:px-10 sm:py-10">
            <p class:list={[selo, "bg-dourado"]}>Demonstração interativa · neste site</p>
            <h3 class="mt-4 text-2xl font-extrabold">Vitrine de componentes</h3>
            <p class="mt-3 leading-relaxed text-white/75">
              Doze componentes funcionando de verdade, como banner, galeria, agendamento e contagem
              regressiva, com a cor e o estilo que você escolher.
            </p>
            <a href="/vitrine/" class="mt-6 inline-block self-start rounded-full bg-azul px-6 py-3 font-bold text-marinho transition-colors hover:bg-white">
              Testar na vitrine
            </a>
          </div>
          <div class="relative hidden px-10 py-10 sm:block" aria-hidden="true">
            <div class="absolute -top-10 -right-10 h-64 w-64 rounded-full bg-azul-medio/30 blur-3xl"></div>
            <div class="relative overflow-hidden rounded-2xl bg-white text-marinho shadow-2xl">
              <div class="flex items-center justify-between border-b border-marinho/10 px-4 py-2.5">
                <span class="h-2.5 w-28 rounded-full bg-marinho/20"></span>
                <span class="flex gap-1.5">
                  <span class="h-4 w-4 rounded-full bg-[#0F9D58]"></span>
                  <span class="h-4 w-4 rounded-full bg-[#D93025]"></span>
                  <span class="h-4 w-4 rounded-full bg-azul-medio ring-2 ring-marinho ring-offset-1"></span>
                  <span class="h-4 w-4 rounded-full bg-[#7C3AED]"></span>
                </span>
              </div>
              <div class="bg-slate-100 p-4">
                <div class="rounded-lg bg-azul-medio p-5 text-white">
                  <span class="block h-2 w-16 rounded-full bg-white/60"></span>
                  <span class="mt-3 block h-3.5 w-3/4 rounded-full bg-white"></span>
                  <span class="mt-2 block h-3.5 w-1/2 rounded-full bg-white"></span>
                  <span class="mt-4 block h-6 w-24 rounded-full bg-white/90"></span>
                </div>
                <div class="mt-3 grid grid-cols-3 gap-2">
                  <span class="h-12 rounded-lg bg-white"></span>
                  <span class="h-12 rounded-lg bg-white"></span>
                  <span class="h-12 rounded-lg bg-white"></span>
                </div>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Comparação de tecnologias: secundária, recolhida (escopo, referências visuais). -->
  <section aria-labelledby="tecnico-titulo" class="bg-[#f4f9fd] text-marinho">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="text-sm font-bold tracking-[0.18em] text-azul-texto uppercase">Para quem gosta de detalhes técnicos</p>
      <details id="detalhes-tecnicos" class="group mt-4 scroll-mt-24 rounded-3xl bg-white ring-1 ring-marinho/10">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-3xl p-6 sm:p-8 [&::-webkit-details-marker]:hidden">
          <h2 id="tecnico-titulo" class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            Quanto cada tecnologia pesa no celular
          </h2>
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-marinho/5 text-azul-texto transition-transform group-open:rotate-45" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
          </span>
        </summary>
        <div class="border-t border-marinho/10 px-6 pt-6 pb-8 sm:px-8">
          <p class="max-w-3xl leading-relaxed text-marinho/75">
            Medimos a mesma página do Café Aurora em quatro tecnologias. O JavaScript é o que mais pesa
            para o celular de quem visita: quanto menos, mais cedo a página fica pronta para uso. Esses
            números ajudam a escolher a tecnologia certa para cada projeto. Este site, por exemplo, é
            feito com Astro.
          </p>
          <div class="mt-8">
            <ComparativoStacks />
          </div>
        </div>
      </details>
    </div>
  </section>

  <Cta title="Quer que o seu site seja o primeiro projeto daqui?" />
</Base>

<script>
  // O link do card abre o comparativo antes de rolar até ele.
  document.querySelector("[data-abrir-detalhes]")?.addEventListener("click", () => {
    const detalhes = document.getElementById("detalhes-tecnicos") as HTMLDetailsElement | null;
    if (detalhes) detalhes.open = true;
  });
</script>
