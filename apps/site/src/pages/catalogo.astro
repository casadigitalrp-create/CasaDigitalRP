---
import Cta from "../components/Cta.astro";
import PageHeader from "../components/PageHeader.astro";
import { acoes, gatilhos, integracoes, receitas } from "../data/catalogo";
import Base from "../layouts/Base.astro";

const chip =
  "cursor-pointer rounded-full border border-chama/60 px-4 py-2 text-[15px] font-bold text-nevoa transition-colors hover:border-chama has-[:checked]:border-chama has-[:checked]:bg-chama has-[:checked]:text-grafite has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-chama";
---

<Base title="Automações" description="Receitas prontas de automação com n8n e um simulador para montar o seu fluxo: WhatsApp, planilhas, e-mail, IA e integrações entre sistemas.">
  <PageHeader
    eyebrow="Automações"
    title="O que o seu negócio pode fazer sozinho?"
    text="Escolha uma receita pronta ou monte o seu próprio fluxo em poucos cliques. A gente cuida da parte técnica."
  />

  <!-- 1. Receitas prontas -->
  <section aria-labelledby="receitas-titulo" class="bg-fundo">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-bold tracking-[0.18em] text-marca-texto uppercase">Receitas prontas</p>
        <h2 id="receitas-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
          Automações que já fazem diferença em pequenos negócios
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-suave">Reconheceu a sua rotina em alguma delas? Um clique e ela vai junto para o seu pedido.</p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          receitas.map((r) => (
            <li class="receita group flex flex-col rounded-3xl border border-borda bg-superficie p-7 transition-transform hover:-translate-y-1.5 hover:border-marca">
              <ol class="flex items-center gap-2 text-xs font-bold text-suave" aria-label={`Fluxo: ${r.fluxo.join(", ")}`}>
                {r.fluxo.map((etapa, i) => (
                  <li class="flex flex-1 items-center gap-2 last:flex-none">
                    <span class="flex flex-col items-center gap-1.5">
                      <span class={`block h-4 w-4 rounded-full ${i === 1 ? "bg-marca" : "border-[3px] border-marca bg-superficie"}`} aria-hidden="true" />
                      <span class="whitespace-nowrap">{etapa}</span>
                    </span>
                    {i < 2 && (
                      <span class="receita-linha relative -mt-5 h-0.5 flex-1 overflow-hidden rounded-full bg-borda" aria-hidden="true">
                        <span class="absolute inset-0 origin-left scale-x-0 bg-marca transition-transform duration-500 group-hover:scale-x-100" />
                      </span>
                    )}
                  </li>
                ))}
              </ol>
              <h3 class="mt-6 text-xl font-extrabold">{r.titulo}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-suave">{r.texto}</p>
              <button
                type="button"
                data-receita={JSON.stringify({ solucao: r.solucao, integracoes: r.integracoes })}
                class="mt-6 self-start rounded-full border border-marca px-5 py-2.5 font-bold text-marca-texto transition-colors hover:bg-marca hover:text-grafite"
              >
                Quero esta automação
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. Simulador -->
  <section aria-labelledby="simulador-titulo" class="relative overflow-hidden bg-grafite text-nevoa">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1fr_1fr] lg:items-start">
      <form id="simulador" class="space-y-10">
        <div>
          <p class="text-sm font-bold tracking-[0.18em] text-brasa uppercase">Simulador</p>
          <h2 id="simulador-titulo" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl">
            Monte o seu fluxo
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-areia">Escolha o que dispara a automação e o que deve acontecer. O fluxo se desenha ao lado.</p>
        </div>
        <fieldset>
          <legend class="text-xl font-extrabold">Quando…</legend>
          <div class="mt-4 flex flex-wrap gap-3">
            {gatilhos.map((g, i) => <label class={chip}><input type="radio" name="gatilho" value={g.id} class="sr-only" checked={i === 0} />{g.rotulo}</label>)}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-xl font-extrabold">Então…</legend>
          <p class="mt-1 text-sm text-areia">Escolha quantas quiser.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            {acoes.map((a, i) => <label class={chip}><input type="checkbox" name="acao" value={a.id} class="sr-only" checked={i === 0 || i === 3} />{a.rotulo}</label>)}
          </div>
        </fieldset>
      </form>

      <div class="rounded-3xl border border-white/10 bg-grafite-claro p-7 lg:sticky lg:top-28">
        <p class="text-sm font-bold text-areia">O seu fluxo</p>
        <ol id="fluxo" class="mt-6 space-y-4" aria-live="polite"></ol>
        <p id="fluxo-frase" class="mt-6 leading-relaxed text-nevoa"></p>
        <p id="fluxo-erro" class="mt-4 hidden font-bold text-faisca" role="alert">Escolha pelo menos uma ação em "Então…".</p>
        <button id="quero-fluxo" type="button" class="mt-6 w-full rounded-full bg-chama px-7 py-3.5 text-lg font-bold text-grafite transition-colors hover:bg-faisca">
          Quero este fluxo
        </button>
        <p class="mt-3 text-center text-sm text-areia">Ele vai junto para o formulário de contato.</p>
      </div>
    </div>
  </section>

  <!-- 3. Integrações -->
  <section aria-labelledby="integracoes-titulo" class="bg-superficie">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <h2 id="integracoes-titulo" class="text-2xl font-extrabold tracking-tight sm:text-3xl">Conversa com o que você já usa</h2>
      <p class="mx-auto mt-3 max-w-xl text-suave">Você não precisa trocar de ferramenta. A automação liga o que já existe.</p>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          integracoes.map((nome) => (
            <li class="flex items-center gap-2 rounded-full border border-borda bg-fundo px-5 py-2.5 font-bold">
              <span class="h-2.5 w-2.5 rounded-full bg-marca" aria-hidden="true" />
              {nome === "API ou sistema existente" ? "O seu sistema" : nome === "Google Gemini" ? "Inteligência artificial" : nome}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta title="Não achou a sua tarefa? Conta pra gente." text="Descreva a rotina que toma o seu tempo. Em uma conversa, mostramos o que dá para automatizar." />

  <script type="application/json" id="simulador-dados" set:html={JSON.stringify({ gatilhos, acoes })} />
</Base>

<script>
  import { chaveSelecao, type SelecaoCatalogo } from "../data/catalogo";

  interface Opcao {
    id: string;
    rotulo: string;
    quando?: string;
    no: string;
    integracao: string;
  }
  const { gatilhos, acoes } = JSON.parse(document.getElementById("simulador-dados")?.textContent ?? "{}") as {
    gatilhos: Opcao[];
    acoes: Opcao[];
  };

  // A escolha segue para o Contato pela mesma chave e no mesmo formato usados desde a V3.
  const irParaContato = (selecao: SelecaoCatalogo) => {
    try {
      sessionStorage.setItem(chaveSelecao, JSON.stringify(selecao));
    } catch {
      /* Sem armazenamento: o visitante descreve a escolha no formulário. */
    }
    location.href = "/contato/#form-titulo";
  };

  for (const botao of document.querySelectorAll<HTMLButtonElement>("[data-receita]")) {
    botao.addEventListener("click", () => {
      const { solucao, integracoes } = JSON.parse(botao.dataset.receita ?? "{}") as { solucao: string; integracoes: string[] };
      irParaContato({ solucao, componentes: [], recursos: [], integracoes });
    });
  }

  const form = document.getElementById("simulador") as HTMLFormElement;
  const fluxo = document.getElementById("fluxo") as HTMLOListElement;
  const frase = document.getElementById("fluxo-frase") as HTMLParagraphElement;
  const erro = document.getElementById("fluxo-erro") as HTMLParagraphElement;

  const ler = () => {
    const gatilho = gatilhos.find((g) => g.id === form.querySelector<HTMLInputElement>('input[name="gatilho"]:checked')?.value);
    const escolhidas = [...form.querySelectorAll<HTMLInputElement>('input[name="acao"]:checked')]
      .map((i) => acoes.find((a) => a.id === i.value))
      .filter((a): a is Opcao => Boolean(a));
    return { gatilho, escolhidas };
  };

  const no = (texto: string, tipo: "anel" | "cheio", atraso: number) => {
    const li = document.createElement("li");
    li.className = "flex items-center gap-4 opacity-0 transition-opacity duration-500";
    li.style.transitionDelay = `${atraso}ms`;
    const ponto = document.createElement("span");
    ponto.className = `h-5 w-5 shrink-0 rounded-full ${tipo === "anel" ? "border-[3px] border-chama" : "bg-chama"}`;
    const caixa = document.createElement("span");
    caixa.className = "flex-1 rounded-xl border border-white/10 bg-grafite px-4 py-3 font-semibold";
    caixa.textContent = texto;
    li.append(ponto, caixa);
    requestAnimationFrame(() => requestAnimationFrame(() => li.classList.remove("opacity-0")));
    return li;
  };

  const desenhar = () => {
    const { gatilho, escolhidas } = ler();
    fluxo.replaceChildren();
    if (!gatilho) return;
    fluxo.append(no(gatilho.no, "anel", 0), no("n8n organiza e decide", "cheio", 120));
    escolhidas.forEach((a, i) => fluxo.append(no(a.no, i === escolhidas.length - 1 ? "anel" : "cheio", 240 + i * 120)));
    frase.textContent = escolhidas.length
      ? `${gatilho.quando}, a automação vai ${escolhidas.map((a) => a.rotulo.toLowerCase()).join(", ").replace(/, ([^,]*)$/, " e $1")}.`
      : "";
    erro.classList.add("hidden");
  };

  form.addEventListener("change", desenhar);
  desenhar();

  document.getElementById("quero-fluxo")?.addEventListener("click", () => {
    const { gatilho, escolhidas } = ler();
    if (!gatilho || !escolhidas.length) {
      erro.classList.remove("hidden");
      return;
    }
    irParaContato({
      solucao: "Automações personalizadas",
      componentes: [`Quando: ${gatilho.rotulo}`, ...escolhidas.map((a) => `Então: ${a.rotulo}`)],
      recursos: [],
      integracoes: [...new Set(["n8n", gatilho.integracao, ...escolhidas.map((a) => a.integracao)])],
    });
  });
</script>
