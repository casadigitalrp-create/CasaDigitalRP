---
import PageHeader from "../components/PageHeader.astro";
import { integracoes, recursos, solucoes } from "../data/catalogo";
import { componentes } from "../data/componentes";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";

const campo =
  "rounded-2xl border border-marinho/15 bg-white p-4 shadow-sm has-[:checked]:border-azul-medio has-[:checked]:bg-azul/10 focus-within:outline-3 focus-within:outline-azul-medio";
---

<Base title="Catálogo de soluções" description="Escolha uma solução, componentes, recursos e integrações para receber uma análise técnica da CasaDigitalRP. Sem preços públicos.">
  <PageHeader eyebrow="Catálogo" title="Monte a sua solicitação" text="Escolha o que faz sentido para o seu projeto. Analisamos a combinação antes de apresentar proposta, prazo ou investimento." />
  <section class="bg-[#f4f9fd] px-4 py-14 text-marinho sm:px-6 lg:py-20">
    <form id="catalogo" class="mx-auto max-w-6xl space-y-12">
      <fieldset>
        <legend class="text-2xl font-extrabold">1. Solução principal</legend>
        <p class="mt-2 text-marinho/70">Selecione uma opção. Podemos ajustar o escopo na conversa.</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {solucoes.map((nome) => <label class={campo}><input type="radio" name="solucao" value={nome} class="mr-2 accent-azul-medio" required />{nome}</label>)}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-2xl font-extrabold">2. Componentes do site</legend>
        <p class="mt-2 text-marinho/70">Escolha quantos quiser. A Vitrine mostra demonstrações de vários deles.</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {componentes.filter((item) => !["depoimentos", "parceiros"].includes(item.id)).map((item) =>
            <label class={campo}><input type="checkbox" name="componentes" value={item.nome} class="mr-2 accent-azul-medio" /><strong>{item.nome}</strong><span class="mt-1 block text-sm text-marinho/70">{item.descricao}</span></label>
          )}
        </div>
        <p class="mt-4 text-sm text-marinho/70">Depoimentos e marcas parceiras só podem ser publicados com conteúdo real e autorização.</p>
      </fieldset>

      <fieldset>
        <legend class="text-2xl font-extrabold">3. Recursos adicionais</legend>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {recursos.map((nome) => <label class={campo}><input type="checkbox" name="recursos" value={nome} class="mr-2 accent-azul-medio" />{nome}</label>)}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-2xl font-extrabold">4. Integrações necessárias</legend>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {integracoes.map((nome) => <label class={campo}><input type="checkbox" name="integracoes" value={nome} class="mr-2 accent-azul-medio" />{nome}</label>)}
        </div>
      </fieldset>

      <div class="rounded-3xl bg-marinho p-6 text-white sm:p-8">
        <h2 class="text-xl font-extrabold">Resumo da escolha</h2>
        <p id="catalogo-resumo" class="mt-3 whitespace-pre-line text-white/85" aria-live="polite">Selecione uma solução para começar.</p>
        <p id="catalogo-erro" class="mt-4 hidden font-bold text-amber-200" role="alert"></p>
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" id="continuar-contato" class="rounded-full bg-azul px-6 py-3 font-bold text-marinho hover:bg-white">Continuar para Contato</button>
          <a id="catalogo-whatsapp" href="#" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/50 px-6 py-3 font-bold text-white hover:bg-white/10">Enviar resumo pelo WhatsApp</a>
        </div>
        <p class="mt-4 text-sm text-white/65">Nenhum preço ou prazo é calculado aqui. A seleção fica nesta sessão do navegador para preencher Contato.</p>
      </div>
    </form>
  </section>
</Base>

<script define:vars={{ whatsapp: site.whatsapp }}>
  const chave = "cdrp-catalogo-selecao-v1";
  const form = document.getElementById("catalogo");
  const selecionados = (nome) => [...form.querySelectorAll(`input[name="${nome}"]:checked`)].map((item) => item.value);
  const ler = () => ({
    solucao: selecionados("solucao")[0] || "",
    componentes: selecionados("componentes"),
    recursos: selecionados("recursos"),
    integracoes: selecionados("integracoes"),
  });
  const resumo = (s) => [
    `Solução: ${s.solucao || "Ainda não escolhida"}`,
    `Componentes: ${s.componentes.join(", ") || "Nenhum"}`,
    `Recursos: ${s.recursos.join(", ") || "Nenhum"}`,
    `Integrações: ${s.integracoes.join(", ") || "Nenhuma"}`,
  ].join("\n");
  function atualizar() {
    const s = ler();
    document.getElementById("catalogo-resumo").textContent = resumo(s);
    sessionStorage.setItem(chave, JSON.stringify(s));
    document.getElementById("catalogo-whatsapp").href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(`Olá! Escolhi estas opções no catálogo da CasaDigitalRP:\n${resumo(s)}`)}`;
  }
  try {
    const salvo = JSON.parse(sessionStorage.getItem(chave) || "null");
    if (salvo && typeof salvo === "object") {
      for (const input of form.querySelectorAll("input")) {
        const valores = input.name === "solucao" ? [salvo.solucao] : salvo[input.name];
        input.checked = Array.isArray(valores) && valores.includes(input.value);
      }
    }
  } catch { /* Seleção antiga inválida: iniciar sem preenchimento. */ }
  form.addEventListener("change", atualizar);
  atualizar();
  document.getElementById("continuar-contato").addEventListener("click", () => {
    if (!ler().solucao) {
      const erro = document.getElementById("catalogo-erro");
      erro.textContent = "Escolha a solução principal antes de continuar.";
      erro.classList.remove("hidden");
      form.querySelector('input[name="solucao"]').focus();
      return;
    }
    location.href = "/contato/#form-titulo";
  });
</script>
